rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /bills/{plantId}/{file} {
      allow read: if request.auth != null && request.auth.uid == plantId;
      allow write: if request.auth != null && request.auth.uid == plantId
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
