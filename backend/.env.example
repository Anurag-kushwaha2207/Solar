# =====================================================================
# UrjaMind Backend Configuration Environment Variables
# Copy this file to .env and fill in the values for your deployment.
# =====================================================================

# ── Claude Agentic Copilot ──────────────────────────────────────────
# Required for LLM tool-calling copilot. If omitted, UrjaMind uses
# its deterministic, tool-grounded rule engine fallback.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Meta WhatsApp Cloud API ─────────────────────────────────────────
# Configured for webhook verification and outbound automated dispatch.
WHATSAPP_VERIFY_TOKEN=urjamind_verify_token_2026
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
META_APP_SECRET=your_meta_app_secret_here

# ── Twilio WhatsApp Sandbox (Alternative to Meta) ───────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Firebase Authentication & Admin ─────────────────────────────────
# Path to service account JSON (never commit the JSON key file to git)
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Server Configuration ────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
PUBLIC_BASE_URL=https://your-deployment-url.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
